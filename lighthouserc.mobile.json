{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start -p 3201",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3201/", "http://localhost:3201/work/refattura"],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
