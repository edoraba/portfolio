    "@content-collections/mdx": "0.2.2",
    "@content-collections/next": "0.2.11",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
